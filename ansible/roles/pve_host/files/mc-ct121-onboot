#!/bin/bash
set -u
CONF=/etc/pve/nodes/pve/lxc/121.conf
case "${SSH_ORIGINAL_COMMAND:-}" in
  0|1) V="$SSH_ORIGINAL_COMMAND" ;;
  *) echo "denied"; exit 2 ;;
esac
[ -f "$CONF" ] || { echo "config not found"; exit 1; }
python3 - "$CONF" "$V" <<'PY'
import sys,re
p,v=sys.argv[1],sys.argv[2]
s=open(p).read()
if re.search(r'^onboot: \d', s, re.M):
    s=re.sub(r'^onboot: \d', f'onboot: {v}', s, count=1, flags=re.M)
else:
    s=s.replace('\n', f'\nonboot: {v}\n', 1)
open(p,'w').write(s)
PY
grep '^onboot' "$CONF"
